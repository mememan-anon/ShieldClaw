{
  "name": "shieldclaw",
  "version": "0.1.0",
  "description": "AI Agent Security Framework with runtime monitoring, skill verification, isolated execution, and prompt injection defense",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run build && node src/api/server.js",
    "dev": "node src/api/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node tests/unit.test.js",
    "test:integration": "node tests/integration.test.js",
    "demo:malicious": "node demos/malicious-skill.js",
    "demo:injection": "node demos/injection-demo.js",
    "demo:secure": "node demos/secure-execution.js",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "ai-security",
    "agent-safety",
    "runtime-monitoring",
    "ebpf",
    "blockchain",
    "sui",
    "sandbox"
  ],
  "author": "ShieldClaw Security Team",
  "license": "MIT",
  "dependencies": {
    "@mysten/sui": "^1.45.2",
    "axios": "^1.6.7",
    "dockerode": "^4.0.2",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "openai": "^4.28.0",
    "pidusage": "^3.0.2",
    "systeminformation": "^5.21.20",
    "winston": "^3.11.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
